# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/apps/cli/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# docker / runtime secrets
/secrets/
*.secret

# relay database when running outside Docker
/apps/server/data/

# typescript
*.tsbuildinfo
.pi/
skills

# claude code local, except project skills which are shared knowledge
/.claude/*
!/.claude/skills/
