generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ──────────────────────────────────────────────
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Trek board-of-boards: the meta status columns boards are organised into
  // (array of { id, title, color, position }). Seeded on first use.
  boardColumns  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  notes               Note[]
  folders             Folder[]
  assets              MediaAsset[]
  passwordResetTokens PasswordResetToken[]
  operationLogs       OperationLog[]
  canvases            Canvas[]
  mcpAccessTokens     McpAccessToken[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ────────────────────────────────────────────
model Folder {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  position  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([userId])
}

model Note {
  id                   String                   @id @default(uuid())
  title                String                   @default("Untitled")
  slug                 String?                  @unique
  icon                 String?
  coverImage           String?
  folderId             String?
  folder               Folder?                  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  userId               String
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position             Int                      @default(0)
  isPinned             Boolean                  @default(false)
  isArchived           Boolean                  @default(false)
  isPublished          Boolean                  @default(false)
  quadrant             String?
  // Trek (Kanban): non-null => this note is a board. Array of
  // { id, title, color, position } column definitions. Cards are the note's
  // taskItem blocks, placed via block.attributes.kanbanColumnId/kanbanPosition.
  kanbanColumns        Json?
  // Board-of-boards placement: which User.boardColumns status this board sits
  // in, and its order within that status. Only meaningful for board notes.
  kanbanStatus         String?
  kanbanStatusPosition Int?
  searchText           String                   @default("")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  // PostgreSQL full-text projection used by the raw search endpoint. Prisma
  // Client intentionally treats tsvector as unsupported.
  searchVector         Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(\"searchText\", ''::text)), 'B'::\"char\"))"))

  blocks        Block[]
  outgoingLinks Link[]       @relation("OutgoingLinks")
  incomingLinks Link[]       @relation("IncomingLinks")
  assets        MediaAsset[]

  @@index([folderId])
  @@index([userId])
  @@index([position])
  @@index([isArchived])
  @@index([isPinned])
  @@index([updatedAt])
  @@index([quadrant])
  @@index([searchVector], type: Gin)
}

model Block {
  id         String    @id @default(uuid())
  noteId     String
  note       Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  type       String    @default("paragraph")
  content    Json      @default("{}")
  attributes Json      @default("{}")
  parentId   String?
  parent     Block?    @relation("BlockTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Block[]   @relation("BlockTree")
  position   Int       @default(0)
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  links Link[] @relation("BlockLinks")

  @@index([noteId])
  @@index([parentId])
  @@index([noteId, position])
  @@index([dueDate])
}

model Link {
  id            String   @id @default(uuid())
  sourceNoteId  String
  sourceNote    Note     @relation("OutgoingLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  sourceBlockId String?
  sourceBlock   Block?   @relation("BlockLinks", fields: [sourceBlockId], references: [id], onDelete: SetNull)
  targetRaw     String
  targetNoteId  String?
  targetNote    Note?    @relation("IncomingLinks", fields: [targetNoteId], references: [id], onDelete: SetNull)
  linkType      String   @default("wikilink")
  createdAt     DateTime @default(now())

  @@unique([sourceNoteId, sourceBlockId, targetRaw])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetRaw])
}

model MediaAsset {
  id          String   @id @default(uuid())
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  altText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([noteId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OperationLog {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  actionType String
  payload    Json      @default("{}")
  source     String    @default("server")
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model McpAccessToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
}

model AppSetting {
  id             String   @id @default(uuid())
  key            String   @unique
  encryptedValue String
  valuePreview   String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Spatial Canvas Models ────────────────────────────────────

model Canvas {
  id        String   @id @default(uuid())
  title     String   @default("New Map")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  elements  Json     @default("[]")
  appState  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
