generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ──────────────────────────────────────────────
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  notes               Note[]
  folders             Folder[]
  assets              MediaAsset[]
  passwordResetTokens PasswordResetToken[]
  proposals           NoteProposal[]
  feeds               WorkspaceFeed[]
  operationLogs       OperationLog[]
  canvases            Canvas[]
  noteCategories      NoteCategory[]
  noteGptSessions     NoteGptSession[]
  universeState       UniverseState?
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ────────────────────────────────────────────
model Folder {
  id          String                @id @default(uuid())
  name        String
  icon        String?
  parentId    String?
  parent      Folder?               @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]              @relation("FolderTree")
  position    Int                   @default(0)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  feedSources WorkspaceFeedSource[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([parentId])
  @@index([userId])
}

model Note {
  id          String        @id @default(uuid())
  title       String        @default("Untitled")
  slug        String?       @unique
  icon        String?
  coverImage  String?
  folderId    String?
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  templateId  String?
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Int           @default(0)
  isPinned    Boolean       @default(false)
  isArchived  Boolean       @default(false)
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  blocks        Block[]
  tags          NoteTag[]
  outgoingLinks Link[]                @relation("OutgoingLinks")
  incomingLinks Link[]                @relation("IncomingLinks")
  assets        MediaAsset[]
  proposals     NoteProposal[]
  feedSources   WorkspaceFeedSource[]
  canvasNodes   CanvasNode[]

  @@index([folderId])
  @@index([categoryId])
  @@index([userId])
  @@index([position])
  @@index([isArchived])
  @@index([isPinned])
  @@index([updatedAt])
}

model NoteCategory {
  id          String                @id @default(uuid())
  name        String
  color       String                @default("slate")
  icon        String?
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  feedSources WorkspaceFeedSource[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model Block {
  id         String   @id @default(uuid())
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  type       String   @default("paragraph")
  content    Json     @default("{}")
  attributes Json     @default("{}")
  parentId   String?
  parent     Block?   @relation("BlockTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Block[]  @relation("BlockTree")
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  links Link[] @relation("BlockLinks")

  @@index([noteId])
  @@index([parentId])
  @@index([noteId, position])
}

model Link {
  id            String   @id @default(uuid())
  sourceNoteId  String
  sourceNote    Note     @relation("OutgoingLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  sourceBlockId String?
  sourceBlock   Block?   @relation("BlockLinks", fields: [sourceBlockId], references: [id], onDelete: SetNull)
  targetRaw     String
  targetNoteId  String?
  targetNote    Note?    @relation("IncomingLinks", fields: [targetNoteId], references: [id], onDelete: SetNull)
  linkType      String   @default("wikilink")
  createdAt     DateTime @default(now())

  @@unique([sourceNoteId, sourceBlockId, targetRaw])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetRaw])
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  notes NoteTag[]

  @@index([name])
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("blank")
  icon        String?
  blocks      Json     @default("[]")
  variables   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model MediaAsset {
  id          String   @id @default(uuid())
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  altText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([noteId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model NoteProposal {
  id         String    @id @default(uuid())
  noteId     String
  note       Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  status     String    @default("pending")
  patch      Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  @@index([noteId])
  @@index([userId])
  @@index([status])
}

model OperationLog {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  actionType String
  payload    Json      @default("{}")
  source     String    @default("server")
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model WorkspaceFeed {
  id                   String                @id @default(uuid())
  title                String
  description          String?
  kind                 String                @default("news")
  refreshIntervalHours Int                   @default(24)
  language             String                @default("mixed")
  queryMode            String                @default("auto")
  queryOverride        String?
  isEnabled            Boolean               @default(true)
  showOnDashboard      Boolean               @default(true)
  lastRefreshedAt      DateTime?
  nextRefreshAt        DateTime?
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources              WorkspaceFeedSource[]
  items                WorkspaceFeedItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([userId, kind])
  @@index([userId, isEnabled, nextRefreshAt])
}

model WorkspaceFeedSource {
  id              String        @id @default(uuid())
  feedId          String
  feed            WorkspaceFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  sourceType      String        @default("manual")
  folderId        String?
  folder          Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteId          String?
  note            Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  includeChildren Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@unique([feedId, folderId])
  @@unique([feedId, noteId])
  @@unique([feedId, categoryId])
  @@index([feedId])
  @@index([feedId, sourceType])
  @@index([folderId])
  @@index([noteId])
  @@index([categoryId])
}

model WorkspaceFeedItem {
  id          String        @id @default(uuid())
  feedId      String
  feed        WorkspaceFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  itemType    String        @default("entry")
  title       String
  summary     String?
  whyRelevant String?
  sourceName  String?
  sourceUrl   String?
  sourceKey   String?
  publishedAt DateTime?
  payload     Json          @default("{}")
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([feedId, sourceKey])
  @@index([feedId, createdAt])
  @@index([feedId, position])
  @@index([feedId, publishedAt])
}

model NoteGptSession {
  id            String           @id @default(uuid())
  title         String           @default("Yeni sohbet")
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      NoteGptMessage[]
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, lastMessageAt])
}

model NoteGptMessage {
  id        String         @id @default(uuid())
  sessionId String
  session   NoteGptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

// ─── Spatial Canvas Models ────────────────────────────────────

model Canvas {
  id        String       @id @default(uuid())
  title     String       @default("Untitled Canvas")
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes     CanvasNode[]
  edges     CanvasEdge[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model UniverseState {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cameraX   Float    @default(0)
  cameraY   Float    @default(0)
  zoom      Float    @default(0.75)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CanvasNode {
  id       String  @id @default(uuid())
  canvasId String
  canvas   Canvas  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  noteId   String?
  note     Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  type     String  @default("note")
  data     Json    @default("{}")
  x        Float   @default(0)
  y        Float   @default(0)
  width    Float   @default(300)
  height   Float   @default(200)
  color    String?

  @@index([canvasId])
  @@index([noteId])
}

model CanvasEdge {
  id           String  @id @default(uuid())
  canvasId     String
  canvas       Canvas  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  sourceNodeId String
  targetNodeId String
  sourceHandle String?
  targetHandle String?
  data         Json    @default("{}")
  type         String  @default("default")

  @@index([canvasId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}
