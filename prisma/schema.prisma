generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ──────────────────────────────────────────────
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  notes               Note[]
  assets              MediaAsset[]
  passwordResetTokens PasswordResetToken[]
  operationLogs       OperationLog[]
  canvases            Canvas[]
  boards              Board[]
  boardStatuses       BoardStatus[]
  mcpAccessTokens     McpAccessToken[]
  blindVaults         BlindVault[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ────────────────────────────────────────────
model Note {
  id           String                   @id @default(uuid())
  title        String                   @default("Untitled")
  icon         String?
  coverImage   String?
  parentId     String?
  parent       Note?                    @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Note[]                   @relation("NoteTree")
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Fractional index: siblings are ordered by comparing these strings, so a
  // move rewrites one row instead of renumbering every sibling.
  position     String                   @default("a0")
  isPinned     Boolean                  @default(false)
  isArchived   Boolean                  @default(false)
  searchText   String                   @default("")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  // PostgreSQL full-text projection used by the raw search endpoint. Prisma
  // Client intentionally treats tsvector as unsupported.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(\"searchText\", ''::text)), 'B'::\"char\"))"))

  blocks           Block[]
  pagePriority     PagePriority?
  boardTaskSource  Board?            @relation("BoardTaskSource")
  canvasReferences CanvasReference[]
  outgoingLinks    Link[]            @relation("OutgoingLinks")
  incomingLinks    Link[]            @relation("IncomingLinks")
  assets           MediaAsset[]

  @@index([parentId])
  @@index([userId])
  @@index([position])
  @@index([isArchived])
  @@index([isPinned])
  @@index([updatedAt])
  @@index([searchVector], type: Gin)
}

model Block {
  id         String   @id @default(uuid())
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  type       String   @default("paragraph")
  content    Json     @default("{}")
  attributes Json     @default("{}")
  parentId   String?
  parent     Block?   @relation("BlockTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Block[]  @relation("BlockTree")
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  links        Link[]        @relation("BlockLinks")
  taskMetadata TaskMetadata?
  boardTask    BoardTask?

  @@index([noteId])
  @@index([parentId])
  @@index([noteId, position])
}

model PagePriority {
  noteId    String   @id
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  slot      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot])
}

model TaskMetadata {
  blockId         String    @id
  block           Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  priority        String?
  dueDate         DateTime?
  durationMinutes Int?
  completed       Boolean   @default(false)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([priority])
  @@index([dueDate])
}

model BoardStatus {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  color     String?
  position  Int      @default(0)
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
}

model Board {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String        @default("Untitled board")
  icon             String?
  taskSourceNoteId String        @unique
  taskSourceNote   Note          @relation("BoardTaskSource", fields: [taskSourceNoteId], references: [id], onDelete: Cascade)
  statusId         String?
  status           BoardStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  statusPosition   Int           @default(0)
  columns          BoardColumn[]
  tasks            BoardTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([statusId, statusPosition])
}

model BoardColumn {
  id        String      @id @default(uuid())
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  color     String?
  position  Int         @default(0)
  tasks     BoardTask[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([boardId, position])
}

model BoardTask {
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  blockId   String      @unique
  block     Block       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  columnId  String
  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@id([boardId, blockId])
  @@index([columnId, position])
}

model Link {
  id            String   @id @default(uuid())
  sourceNoteId  String
  sourceNote    Note     @relation("OutgoingLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  sourceBlockId String?
  sourceBlock   Block?   @relation("BlockLinks", fields: [sourceBlockId], references: [id], onDelete: SetNull)
  targetRaw     String
  targetNoteId  String?
  targetNote    Note?    @relation("IncomingLinks", fields: [targetNoteId], references: [id], onDelete: SetNull)
  linkType      String   @default("wikilink")
  createdAt     DateTime @default(now())

  @@unique([sourceNoteId, sourceBlockId, targetRaw])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetRaw])
}

model MediaAsset {
  id          String   @id @default(uuid())
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  altText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([noteId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OperationLog {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  actionType String
  payload    Json      @default("{}")
  source     String    @default("server")
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model McpAccessToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
}

model AppSetting {
  id             String   @id @default(uuid())
  key            String   @unique
  encryptedValue String
  valuePreview   String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Spatial Canvas Models ────────────────────────────────────

model Canvas {
  id         String            @id @default(uuid())
  title      String            @default("New Map")
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  elements   Json              @default("[]")
  appState   Json              @default("{}")
  references CanvasReference[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
}

model CanvasReference {
  id        String   @id @default(uuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  elementId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([canvasId, elementId])
  @@index([noteId])
}

// ─── Ciphertext-only local-first sync ─────────────────────────
model BlindVault {
  id              String            @id
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  protocolVersion Int               @default(1)
  devices         BlindDevice[]
  records         BlindSyncRecord[]
  checkpoints     BlindCheckpoint[]
  createdAt       DateTime          @default(now())

  @@unique([ownerId, id])
}

model BlindDevice {
  id                   String            @id
  vaultId              String
  vault                BlindVault        @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  name                  String
  signingPublicKey      Bytes
  agreementPublicKey    Bytes
  status                String           @default("active")
  authorizedAt          DateTime         @default(now())
  revokedAt             DateTime?
  lastAckServerSeq      BigInt           @default(0)
  records               BlindSyncRecord[]
  checkpoints           BlindCheckpoint[]

  @@index([vaultId, status])
}

model BlindSyncRecord {
  serverSeq          BigInt      @id @default(autoincrement())
  vaultId            String
  vault              BlindVault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  recordId           String
  deviceId           String
  device             BlindDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  deviceSeq          BigInt
  previousRecordHash Bytes
  objectLocator      Bytes
  keyEpoch           Int
  encodedRecord      Bytes
  recordHash         Bytes
  receivedAt         DateTime    @default(now())

  @@unique([vaultId, recordId])
  @@unique([vaultId, deviceId, deviceSeq])
  @@index([vaultId, serverSeq])
}

model BlindCheckpoint {
  id                String      @id
  vaultId           String
  vault             BlindVault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  coversServerSeq   BigInt
  keyEpoch          Int
  ciphertext        Bytes
  signature         Bytes
  createdByDeviceId String
  createdByDevice   BlindDevice @relation(fields: [createdByDeviceId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())

  @@index([vaultId, coversServerSeq])
}
