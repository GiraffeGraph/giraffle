# Configuration for the blind sync relay (apps/server). Copy to `.env`.
#
# The relay stores ciphertext only. It has no user accounts, no passwords and no
# way to read page content, so these four variables are its entire configuration.

# REQUIRED. The operator credential, as a comma-separated list of vaultId:token
# pairs. Each pair grants one vault access to the relay; every device you pair
# uses the same token for that vault.
#
#   vaultId  1-128 chars of A-Z a-z 0-9 . _ -   (no colon)
#   token    32-512 URL-safe chars              (openssl rand -base64 48)
#
# The relay replaces its whole token table from this variable on every boot:
# removing a pair here revokes it at the next restart, and only the SHA-256
# digest is ever stored.
SYNC_TOKENS=my-vault:CHANGE_ME_RUN_openssl_rand_base64_48

# Host port the relay is published on. The container always listens on 8787
# internally; this only changes where Docker maps it.
SYNC_PORT=8787

# The following two are set by the image and by docker-compose.yml. Set them
# yourself only when running the relay directly with `npm --prefix apps/server run dev`.

# Interface to bind. Default 0.0.0.0.
# HOST=0.0.0.0

# Port to listen on. Default 8787.
# PORT=8787

# SQLite file holding the encrypted records. Default ./data/giraffle-sync.db;
# the container uses /data/giraffle-sync.db on the named volume.
# DATABASE_PATH=./data/giraffle-sync.db
