APP_IMAGE=docker.io/efekurucay/giraffle:latest
APP_PORT=3000
POSTGRES_USER=giraffle
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=giraffle
DATABASE_URL=postgresql://giraffle:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/giraffle?connection_limit=3&pool_timeout=10
NEXTAUTH_URL=http://localhost:3000
LOG_LEVEL=info
# Optional but recommended for rolling deployments / version skew protection
# DEPLOYMENT_ID=release-2026-04-12-001
# Option 1: plain env secret
AUTH_SECRET=CHANGE_ME_TO_A_32_PLUS_CHAR_RANDOM_SECRET
# Option 2: docker secret file (recommended for production)
# AUTH_SECRET_FILE=./secrets/auth_secret.txt
# Optional but recommended if you want encrypted app-managed provider keys in Settings.
# If omitted, Giraffle falls back to AUTH_SECRET.
# APP_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_PLUS_CHAR_RANDOM_SECRET
FEED_REFRESH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_FOR_CRON_REFRESH
# Optional: enables AI-assisted routes such as Spotter and inline note actions.
# Users can also save their own provider key from Settings → Self-host & Integrations.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional: OpenAI-compatible gateway or self-hosted inference endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override update checks for forks
# APP_UPDATE_REPOSITORY=your-org/your-fork
NODE_ENV=production
