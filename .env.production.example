# Bootstrap-only env vars for production. Everything else (OpenAI, OAuth
# providers, upload dir, log level, update repo) is stored encrypted in the
# database and managed at /settings/secrets after first login.

APP_IMAGE=docker.io/efekurucay/giraffle:latest
APP_PORT=3000
POSTGRES_USER=giraffle
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=giraffle
DATABASE_URL=postgresql://giraffle:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/giraffle?connection_limit=3&pool_timeout=10
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=production

# Option 1: plain env secret
AUTH_SECRET=CHANGE_ME_TO_A_32_PLUS_CHAR_RANDOM_SECRET
# Option 2: docker secret file (recommended for production)
# AUTH_SECRET_FILE=./secrets/auth_secret.txt

# Optional: separate encryption key for the secret box. Defaults to AUTH_SECRET.
# APP_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_PLUS_CHAR_RANDOM_SECRET

# Optional: rolling-deployment / version skew identifier
# DEPLOYMENT_ID=release-2026-04-12-001
