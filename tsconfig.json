{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "esnext"
    ],
    // packages/* target every runtime the client runs on, so nothing here may
    // reach for Node globals; an empty list keeps a hoisted @types/* from
    // silently making that legal.
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@giraffle/protocol": [
        "./packages/protocol/index.ts"
      ],
      "@giraffle/sync": [
        "./packages/sync/index.ts"
      ],
      "@giraffle/domain": [
        "./packages/domain/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "apps"
  ]
}
