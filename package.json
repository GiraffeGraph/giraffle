{
  "name": "giraffle",
  "version": "0.11.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run test:run",
    "app": "npm --prefix apps/app run start",
    "app:web": "npm --prefix apps/app run web",
    "server": "npm --prefix apps/server run dev",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "typescript": "^6",
    "vitest": "^4.1.4"
  }
}
